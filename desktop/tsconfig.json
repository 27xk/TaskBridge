{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "common/**/*.ts",
    "renderer/**/*.ts",
    "renderer/**/*.vue",
    "renderer/env.d.ts",
    "electron.vite.config.ts",
    "vite.config.ts"
  ]
}
