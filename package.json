{
  "name": "taskbridge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "TaskBridge workspace toolchain constraints",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "check:user-experience": "node ./scripts/checks/check-user-experience-optimizations.mjs",
    "test:web": "node --test \"web/tests/**/*.test.mjs\"",
    "check:security-config": "node ./scripts/checks/check-security-config.mjs",
    "check:auth-session-config": "node ./scripts/checks/check-auth-session-config.mjs",
    "check:backend-observability": "node ./scripts/checks/check-backend-observability-config.mjs",
    "check:local-bootstrap": "node ./scripts/checks/check-local-bootstrap-config.mjs",
    "check:release-readiness": "node ./scripts/checks/check-release-readiness-config.mjs",
    "check:release-artifacts": "node ./scripts/checks/check-release-artifacts-config.mjs",
    "check:production-hardening": "node ./scripts/checks/check-production-hardening-config.mjs",
    "check:android-localization": "node ./scripts/checks/check-android-localization-config.mjs",
    "check:android-task-delete-confirmation": "node ./scripts/checks/check-android-task-delete-confirmation-config.mjs",
    "check:refresh-singleflight": "node ./scripts/checks/check-refresh-singleflight-config.mjs",
    "check:registration-governance": "node ./scripts/checks/check-registration-governance-config.mjs",
    "check:sync-retry-preservation": "node ./scripts/checks/check-sync-retry-preservation-config.mjs",
    "check:android-list-realtime": "node ./scripts/checks/check-android-list-realtime-config.mjs",
    "check:release-endpoint-defaults": "node ./scripts/checks/check-release-endpoint-defaults-config.mjs",
    "check:android-sync-status-message": "node ./scripts/checks/check-android-sync-status-message-config.mjs",
    "check:android-sync-recovery": "node ./scripts/checks/check-android-sync-recovery-config.mjs",
    "check:ci-workflows": "node ./scripts/checks/check-ci-workflow-config.mjs",
    "check:contract-drift": "node ./scripts/checks/check-contract-drift.mjs",
    "check:source-tests-visible": "node ./scripts/checks/check-source-tests-visible-config.mjs",
    "check:supply-chain": "node ./scripts/checks/check-supply-chain-config.mjs",
    "check:android-data-extraction": "node ./scripts/checks/check-android-data-extraction-config.mjs",
    "check:security-governance": "node ./scripts/checks/check-security-governance-config.mjs",
    "check:ux-priority-polish": "node ./scripts/checks/check-ux-priority-polish.mjs",
    "check:version": "node ./scripts/check-version-source.mjs",
    "check:web-client": "node ./scripts/check-web-client.mjs",
    "check:web-offline-first": "node ./scripts/check-web-offline-first.mjs",
    "check:web-offline-core": "node ./scripts/check-web-offline-core.mjs",
    "smoke:web": "node ./scripts/smoke-web-client.mjs",
    "check:architecture": "node ./scripts/checks/check-architecture-boundaries.mjs",
    "test:tooling": "node --test \"scripts/tests/**/*.test.mjs\"",
    "check:client-contract": "python backend/tools/check_client_contract.py",
    "check:data-budget": "npm --prefix desktop run check:data-budget",
    "check:artifact-budget": "npm --prefix desktop run check:artifact-budget"
  },
  "engines": {
    "node": ">=22.12.0 <24",
    "npm": ">=10 <12"
  }
}
